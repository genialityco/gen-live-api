# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
RTDB_URL=https://your-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# MongoDB
MONGODB_URI=mongodb://localhost:27017/live-events

# Server
PORT=3000

# Copia de la grabación de los vivos de Vimeo a Bunny Stream
# (la repetición usa el video de Bunny por defecto; Vimeo queda de respaldo)
# Token de la cuenta dueña de los videos, con scopes: private video_files
VIMEO_ACCESS_TOKEN=
# Bunny Stream → tu librería → API
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
# Opcional: colección donde guardar las grabaciones
BUNNY_STREAM_COLLECTION_ID=
